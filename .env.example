# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# Publishable kalit (sb_publishable_...). Eski nom ham ishlaydi: NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret kalit (sb_secret_...) — faqat serverda! Hech qachon NEXT_PUBLIC_ qo'shmang.
# Eski nom ham ishlaydi: SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SECRET_KEY=sb_secret_...
# O'qituvchi sifatida ro'yxatdan o'tish uchun maxfiy kod (o'zingiz o'ylab topasiz)
TEACHER_INVITE_CODE=ustoz2026
# SUPABASE_JWKS_URL kerak emas.
